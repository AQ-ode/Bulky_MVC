@model Company

<form method="post">
    <input asp-for="Id" hidden />

    <div class="row">
        <div class="col-10">
            <div class="border p-3 my-4">
                <div class="row pb-2">
                    <h2 class="text-primary">@(@Model.Id != 0 ? "Update" : "Create") Company</h2>
                    <hr />
                </div>
                <div asp-validation-summary="All"></div>

                <div class="row mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Name" class="col-form-label">Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="StreetAddress" class="col-form-label">Street Address</label>
                        <input asp-for="StreetAddress" class="form-control" />
                        <span asp-validation-for="StreetAddress" class="text-danger"></span>
                    </div>
                </div>


                <div class="col-sm-6">
                    <label asp-for="City" class="col-form-label">City</label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4">
                    <label asp-for="State" class="col-form-label">State</label>
                    <input asp-for="State" class="form-control" />
                    <span asp-validation-for="State" class="text-danger"></span>
                </div>
                <div class="col-sm-4">
                    <label asp-for="PhoneNumber" class="col-form-label">Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col">
                        @if (Model.Id != 0)
                        {
                            <button type="submit" class="btn btn-primary" style="width:150px">Update</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary" style="width:150px">Create</button>
                        }

                    </div>
                    <div class="col">
                        <a asp-controller="Company" asp-action="Index" class="btn btn-primary" style="width:150px">Back To List</a>
                    </div>
                </div>
            </div>
        </div>

    </div>

</form>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
